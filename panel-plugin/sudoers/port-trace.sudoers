# Port Trace - Allow sudo group to run network viewer and kill helper without password
# This enables the XFCE panel plugin to query network connections and terminate processes
#
# Both scripts validate input and execute only hardcoded commands
# - ss-network-viewer: ignores all args, always runs /usr/bin/ss -tupln
# - port-trace-kill: validates PID is numeric, runs /usr/bin/kill -9 <PID>
%sudo ALL=(root) NOPASSWD: /usr/local/bin/panel-plugin/helpers/ss-network-viewer.sh
%sudo ALL=(root) NOPASSWD: /usr/local/bin/panel-plugin/helpers/port-trace-kill.sh
